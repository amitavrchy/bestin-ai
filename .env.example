# Copy this file to .env and fill in your keys.
#   cp .env.example .env

# Required for embeddings, RAG answers, Whisper STT, and OpenAI TTS.
OPENAI_API_KEY=

# Models (defaults work well; override if you prefer)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
OPENAI_STT_MODEL=whisper-1

# auto  = whisper word-timings, then Rhubarb CLI, then heuristic
# whisper | rhubarb | heuristic  to force a single backend
LIPSYNC_BACKEND=auto

# Storage (relative to the backend working directory)
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
AUDIO_DIR=./data/audio
BOOKS_INDEX=./data/books.json

# Frontend origin for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chunking / retrieval
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_K=6
