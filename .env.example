# Shared with the product backend; change in production.
AI_INTERNAL_TOKEN=dev-internal-token
# auto tries configured keyed providers, then keyless Pollinations.
LLM_PROVIDER=auto
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Free Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional paid OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# fastembed runs locally; openai and gemini are optional alternatives.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# auto chooses an available transcription key.
STT_PROVIDER=auto
# edge needs no key; openai is optional.
TTS_PROVIDER=edge
# auto, rhubarb, words, or heuristic.
LIPSYNC_BACKEND=auto
DATA_DIR=data
REQUEST_TIMEOUT=20
